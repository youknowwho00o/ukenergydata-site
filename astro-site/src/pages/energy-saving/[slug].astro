---
import Layout from "../../layouts/Layout.astro";
import { Markdown } from "astro/components";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("energy-saving");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data, body } = post;
---

<Layout title={data.title}>
  <article class="max-w-4xl mx-auto mb-20">

    {data.cover && (
      <img
        src={data.cover}
        alt="cover image"
        class="w-full h-64 md:h-80 lg:h-96 object-cover rounded-xl shadow-lg mb-8 border border-[#1E3A5F]/40"
      />
    )}

    <header class="mb-10">
      <h1 class="text-4xl font-bold text-green-300 leading-tight mb-2">
        {data.title}
      </h1>

      <p class="text-gray-400 text-sm italic">
        {new Date(data.date).toLocaleDateString("en-GB", {
          day: "2-digit",
          month: "long",
          year: "numeric",
        })}
      </p>

      {data.description && (
        <p class="text-gray-300 mt-4 text-lg leading-relaxed">
          {data.description}
        </p>
      )}
    </header>

    <div class="prose prose-invert max-w-full prose-headings:text-green-300 prose-a:text-green-400 prose-strong:text-white prose-li:marker:text-green-400 leading-relaxed">
      <Markdown>{body}</Markdown>
    </div>

    <footer class="mt-16 pt-8 border-t border-[#1E3A5F]/40 text-gray-500 text-center text-sm">
      Auto-generated – Energy Saving Module
    </footer>

  </article>
</Layout>